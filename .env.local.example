# Directivo Algarve - Environment Variables Example

# --- NextAuth ---
NEXTAUTH_SECRET=your-secret-key-change-this-in-production
NEXTAUTH_URL=https://duxxialgarve.vercel.app

# --- API Keys (opcional) ---
NEXT_PUBLIC_API_FOOTBALL_KEY=your_api_football_key_here
NEXT_PUBLIC_API_FOOTBALL_HOST=v3.football.api-sports.io
NEXT_PUBLIC_SPORTMONKS_KEY=your_sportmonks_key_here
NEXT_PUBLIC_NEWSAPI_KEY=your_newsapi_key_here

# RSS feed URLs (opcional)
NEXT_PUBLIC_RSS_RECORD=https://www.record.pt/rss
NEXT_PUBLIC_RSS_ABOLA=https://www.abola.pt/rss
NEXT_PUBLIC_RSS_OJOGO=https://www.ojogo.pt/rss

# Site config
NEXT_PUBLIC_SITE_URL=https://duxxialgarve.vercel.app
NEXT_PUBLIC_SITE_NAME="Directivo Algarve - Claque Sporting CP"
NEXT_PUBLIC_SITE_LOGO=/site-images/logotipo.jpg
NEXT_PUBLIC_SITE_LOGO_PNG=/site-images/logotipo.jpg
NEXT_PUBLIC_SITE_LOGO_MASKABLE=/site-images/logotipo.jpg
NEXT_PUBLIC_SITE_HERO_BG=/site-images/background.jpg
NEXT_PUBLIC_SITE_OG_IMAGE=/site-images/imagem5.jpg
NEXT_PUBLIC_SITE_FEATURE_BG=/site-images/imagem5.jpg

# Google Search Console
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Revalidation
REVALIDATE_TIME=300

# Base de dados
DATABASE_URL=postgresql://postgres:postgres@db:5432/sportingcp