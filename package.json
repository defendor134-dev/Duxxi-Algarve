{
  "name": "projeto_duxxi_algarve",
  "version": "1.0.0",
  "description": "Template para site de claque do Sporting Clube de Portugal, baseado no projeto Sporting CP.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "sync:matches": "tsx src/lib/scripts/sync-matches.ts",
    "sync:standings": "tsx src/lib/scripts/sync-standings.ts",
    "sync:squad": "tsx src/lib/scripts/sync-squad.ts",
    "sync:all": "npm run sync:matches && npm run sync:standings && npm run sync:squad",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.8",
    "next": "^14.2.5",
    "next-auth": "^4.24.7",
    "next-seo": "^6.6.0",
    "postcss": "^8.4.39",
    "prisma": "^5.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "use-debounce": "^10.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.13",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "tsx": "^4.16.2",
    "vercel": "^34.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
